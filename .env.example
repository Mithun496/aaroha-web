# Local development defaults only. Do not deploy this file as production configuration.
APP_ENV=development
TRUSTED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
SECRET_KEY=replace-with-a-local-development-secret
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
RATELIMIT_STORAGE_URI=memory://
MAX_UPLOAD_BYTES=10485760
WTF_CSRF_ENABLED=true
AUTO_CREATE_TABLES=false
UPLOAD_DIR=instance/uploads
AI_PROVIDER=disabled
HOST=127.0.0.1
PORT=5000

OTP_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Development mock only. Production currently supports no real payment adapter.
PAYMENT_PROVIDER=mock
STORAGE_PROVIDER=local
AI_PROVIDER=disabled
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
STORAGE_PUBLIC_BASE_URL=

# Production must configure PostgreSQL, Twilio Verify, shared rate-limit storage,
# S3-compatible storage, a strong SECRET_KEY, and administrator credentials.
# DATABASE_URL=
# OTP_PROVIDER=twilio
# RATELIMIT_STORAGE_URI=redis://...
# PAYMENT_PROVIDER=disabled
# STORAGE_PROVIDER=s3
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=60
# GUNICORN_LOG_LEVEL=info
